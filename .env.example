# Local development only. run_backend.sh generates a random secret in .env.
SECRET_KEY=replace-with-a-random-local-secret
IS_PRODUCTION=false
FLASK_HOST=127.0.0.1
FLASK_PORT=8424
FLASK_DEBUG=false

# The seeded local demo account has no email or external-service dependency.
USER_NAME=Local Demo
USER_UID=demo
USER_PASSWORD=GameMakerDemo-2026

# SQLite is automatic. Optional DATABASE_URL can isolate tests or another database.
# Cloud AI, email, Google OAuth, and KASM credentials are optional and stay in .env.
